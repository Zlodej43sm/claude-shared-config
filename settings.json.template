{
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git branch --show-current)",
      "Bash(git symbolic-ref refs/remotes/origin/HEAD)",
      "Bash(git remote -v)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh auth status:*)",
      "Bash(.claude/tools/*)",
      "Bash(python3 .claude/tools/*)",
      "Bash(bash .claude/tools/*)",
      "Bash(python3 \"$PROJECT_ROOT/.claude/tools/*)",
      "Bash(python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-env.py\"",
            "statusMessage": "Syncing .claude/.env into session env..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-pretooluse.py\"",
            "statusMessage": "Running Biome check on prospective save..."
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}
