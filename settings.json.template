{
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git branch --show-current)",
      "Bash(git symbolic-ref refs/remotes/origin/HEAD)",
      "Bash(git remote -v)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh auth status)",
      "Bash(.claude/tools/*)",
      "Bash(python3 .claude/tools/*)",
      "Bash(python3 -I .claude/tools/*)",
      "Bash(bash .claude/tools/*)",
      "Bash(python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/*)"
    ],
    "ask": [
      "Bash(*bb_post_comment.sh*)",
      "Bash(*gh_post_comment.sh*)",
      "Bash(*jira_create_child.sh*)",
      "Bash(*mcp-run.py*)",
      "Bash(*workspace_docs.py* sync*)",
      "Read(.env)",
      "Read(./.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(*.claude/tools/..*)",
      "Bash(git * --output*)",
      "Bash(git grep *-O*)",
      "Bash(git grep *--open-files-in-pager*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(gh auth *--show-token*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-env.py\"",
            "statusMessage": "Syncing .claude/.env into session env..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-pretooluse.py\"",
            "statusMessage": "Running Biome check on prospective save..."
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}
