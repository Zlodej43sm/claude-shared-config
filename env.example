# Developer tooling — consumed by the shared Claude skills/agents (see
# claude-shared-config) and injected into .mcp.json via ${VAR} substitution.
# Copy this file to .claude/.env in each project and fill in the per-project
# values below. NOT read by any project's own application runtime.
#
# Secret fields (BITBUCKET_API_TOKEN, JIRA_API_TOKEN, SONAR_API_TOKEN) are
# 1Password references (op://vault/item/field), resolved at Claude Code
# session start by hooks/sync-env.py via `op read`. Requires the 1Password
# CLI (`brew install --cask 1password-cli`), installed and signed in
# (`op signin`). If `op` isn't available, these are left as unresolved
# op:// strings and any skill needing them fails the same way a missing
# value does today — nothing silently breaks worse than before.

# Bitbucket / Atlassian
BITBUCKET_WORKSPACE=

# Per-project: copy from your Bitbucket URL: bitbucket.org/<workspace>/<slug>.
BITBUCKET_REPO_SLUG=replace-with-your-repo-slug
BITBUCKET_EMAIL=your.name@mail.com
BITBUCKET_API_TOKEN=op://Dev Tooling/atlassian-api-token/credential
JIRA_API_TOKEN=op://Dev Tooling/atlassian-api-token/credential
JIRA_EMAIL=your.name@company.com
JIRA_BASE_URL=https://company.atlassian.net
CONFLUENCE_BASE_URL=https://company.atlassian.net/wiki

# Per-project: default Jira project key used by get-jira-task (e.g. MA, WIDGET).
JIRA_WORKSPACE=replace-with-your-jira-project-key

# SonarQube Cloud (sonarcloud.io). Base URL: https://sonarqube.us for SonarQube Cloud US.
SONAR_API_TOKEN=op://Dev Tooling/sonarcloud-token/credential
SONAR_ORG=
SONAR_URL=https://sonarcloud.io
