# Developer tooling — consumed by the shared Claude skills/agents (see
# claude-shared-config) and injected into .mcp.json via ${VAR} substitution.
# Copy this file to .claude/.env in each project and fill in the per-project
# values below. NOT read by any project's own application runtime.
#
# Secret fields (BITBUCKET_API_TOKEN, GITHUB_TOKEN, JIRA_API_TOKEN,
# SONAR_API_TOKEN, NOTION_TOKEN, ANTHROPIC_API_KEY) are
# 1Password references (op://vault/item/field), resolved at Claude Code
# session start by hooks/sync-env.py via `op read`. Requires the 1Password
# CLI (`brew install --cask 1password-cli`), installed and signed in
# (`op signin`). If `op` isn't available, these are left as unresolved
# op:// strings and any skill needing them fails the same way a missing
# value does today — nothing silently breaks worse than before.

# Anthropic API key — optional. When set to a real key, Claude Code authenticates with
# it (instead of the `claude` login) from the next session start, and every skill/agent
# that calls the Anthropic API inherits it. Left unset, commented out, or as a
# placeholder / unresolved op:// reference, it is ignored and the login keeps working.
# ANTHROPIC_API_KEY=op://Dev Tooling/anthropic-api-key/credential

# Git hosting backend for pr-review / answer-pr-comments / split-pr's PR
# lookup, and for whether the `github` MCP server is enabled (github -> on;
# bitbucket -> off, the PR skills use REST tools only; hooks/sync-env.py flips it
# at session start). Optional — auto-detected from `git remote get-url origin`
# (bitbucket.org -> bitbucket, github.com -> github) via
# tools/detect_git_host.sh. Set explicitly only when auto-detection can't
# work (self-hosted/enterprise remote, no origin configured, etc.).
GIT_HOST=

# Bitbucket / Atlassian — required when GIT_HOST resolves to "bitbucket".
BITBUCKET_WORKSPACE=

# Per-project: copy from your Bitbucket URL: bitbucket.org/<workspace>/<slug>.
BITBUCKET_REPO_SLUG=replace-with-your-repo-slug
BITBUCKET_EMAIL=your.name@mail.com
BITBUCKET_API_TOKEN=op://Dev Tooling/atlassian-api-token/credential

# GitHub — used when GIT_HOST resolves to "github". No API key needed:
#  - GITHUB_OWNER / GITHUB_REPO default to the origin remote (github.com/<owner>/<repo>)
#    when unset or left as the template values below.
#  - GITHUB_TOKEN: if unset, a placeholder, or an unresolved op:// reference, the token
#    of your `gh auth login` session (browser sign-in; `brew install gh`) is used, for
#    the REST tools and the `github` MCP server alike. Set it only to pin a specific
#    token: repo scope (classic PAT) or Contents+Pull requests read/write (fine-grained).
GITHUB_OWNER=
GITHUB_REPO=replace-with-your-repo-name
GITHUB_TOKEN=op://Dev Tooling/github-token/credential
# Only set for GitHub Enterprise Server (e.g. https://git.example.com/api/v3);
# leave unset for github.com. Used by the gh_*.sh REST tools.
GITHUB_API_URL=
# Only for GitHub Enterprise Server / GHE.com: web host for the `github` MCP
# server (e.g. https://git.example.com). Leave unset for github.com.
GITHUB_HOST=

# Jira / Confluence. JIRA_BASE_URL and JIRA_WORKSPACE are required. JIRA_EMAIL +
# JIRA_API_TOKEN are optional: while they are unset / placeholders, the hosted
# `atlassian-oauth` MCP server is used instead — sign in once from
# /mcp > atlassian-oauth > Authenticate (browser window, no API key). The API token
# is still needed for the REST-only features: ticket image attachments, the REST
# fallback when MCP is down, and the PR-review Jira preflight.
JIRA_API_TOKEN=op://Dev Tooling/atlassian-api-token/credential
JIRA_EMAIL=your.name@company.com
JIRA_BASE_URL=https://company.atlassian.net
CONFLUENCE_BASE_URL=https://company.atlassian.net/wiki

# Per-project: default Jira project key used by get-jira-task (e.g. MA, WIDGET).
JIRA_WORKSPACE=replace-with-your-jira-project-key

# SonarQube Cloud (sonarcloud.io). Base URL: https://sonarqube.us for SonarQube Cloud US.
SONAR_API_TOKEN=op://Dev Tooling/sonarcloud-token/credential
SONAR_ORG=
SONAR_URL=https://sonarcloud.io

# Notion — nothing to set for the default: the hosted `notion-oauth` MCP server is
# enabled automatically; sign in once from /mcp > notion-oauth > Authenticate (a
# browser window opens, no API key needed). To use an API key instead, create an
# internal integration at notion.so/profile/integrations, share each page/database
# you want Claude to read with it (page menu > Connections) and uncomment
# NOTION_TOKEN — hooks/sync-env.py then switches to the token-based `notion`
# server at the next session start. NOTION_MCP=off disables Notion entirely.
# NOTION_TOKEN=op://Dev Tooling/notion-token/credential
# NOTION_MCP=off
